<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YchebPrivetPiter.ViewModels"
        x:Class="YchebPrivetPiter.Views.PaymentEditWindow"
        x:DataType="vm:PaymentEditViewModel"
        Title="{Binding Title}"
        Width="480" Height="520"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FF1E1E2E">
    <Grid RowDefinitions="*,Auto" Margin="20">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12">

                <!-- Информация о счёте -->
                <Border Background="#FF2A2A3C" CornerRadius="10" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Text="Счёт" Foreground="White" Opacity="0.7"/>
                        <TextBlock Grid.Column="1" Text="{Binding InvoiceNumber}"
                                   Foreground="White" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Text="Клиент" Foreground="White" Opacity="0.7"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ClientName}"
                                   Foreground="White"/>

                        <TextBlock Grid.Row="2" Text="Сумма счёта" Foreground="White" Opacity="0.7"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding TotalAmount, StringFormat='{}{0:N2} ₽'}"
                                   Foreground="White"/>

                        <TextBlock Grid.Row="3" Text="Остаток к оплате" Foreground="White" Opacity="0.7"/>
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding Remaining, StringFormat='{}{0:N2} ₽'}"
                                   Foreground="#FF4CD964" FontWeight="Bold"/>
                    </Grid>
                </Border>

                <!-- Сумма платежа -->
                <TextBlock Text="Сумма платежа *" Foreground="White" Opacity="0.8"/>
                <NumericUpDown Value="{Binding Amount}"
                               Minimum="0" Maximum="99999999"
                               Increment="500"
                               FormatString="0.00"
                               HorizontalAlignment="Stretch"/>

                <!-- Способ оплаты -->
                <TextBlock Text="Способ оплаты" Foreground="White" Opacity="0.8"/>
                <ComboBox ItemsSource="{Binding AllMethods}"
                          SelectedItem="{Binding Method}"
                          HorizontalAlignment="Stretch"/>

                <!-- Номер транзакции -->
                <TextBlock Text="Номер транзакции" Foreground="White" Opacity="0.8"/>
                <TextBox Text="{Binding TransactionNumber}"
                         Watermark="TXN-0001 (необязательно)"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FFEF5350"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    Padding="20,8"/>
            <Button Content="Зарегистрировать"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Background="#FF7C4DFF"
                    Foreground="White"
                    Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>