<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YchebPrivetPiter.ViewModels"
        xmlns:d="using:YchebPrivetPiter.Data"
        x:Class="YchebPrivetPiter.Views.CarEditWindow"
        x:DataType="vm:CarEditViewModel"
        Title="{Binding Title}"
        Width="520" Height="640"
        MinWidth="460" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FF1E1E2E">
    <Grid RowDefinitions="*,Auto" Margin="20">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12">

                <TextBlock Text="Клиент *" Foreground="White" Opacity="0.8"/>
                <ComboBox ItemsSource="{Binding Clients}"
                          SelectedItem="{Binding SelectedClient}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="d:Client" x:DataType="d:Client">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding FullName}"/>
                                <TextBlock Text="{Binding Phone}" Opacity="0.6"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Марка *" Foreground="White" Opacity="0.8"/>
                <ComboBox ItemsSource="{Binding Brands}"
                          SelectedItem="{Binding SelectedBrand}"
                          HorizontalAlignment="Stretch"
                          DisplayMemberBinding="{Binding Name}"/>

                <TextBlock Text="Категория" Foreground="White" Opacity="0.8"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          HorizontalAlignment="Stretch"
                          DisplayMemberBinding="{Binding Name}"/>

                <TextBlock Text="Модель *" Foreground="White" Opacity="0.8"/>
                <TextBox Text="{Binding Model}" Watermark="Camry"/>

                <TextBlock Text="Год выпуска" Foreground="White" Opacity="0.8"/>
                <NumericUpDown Value="{Binding ProductionYear}"
                               Minimum="1900" Maximum="2100"
                               Increment="1"
                               FormatString="0"
                               HorizontalAlignment="Stretch"/>

                <TextBlock Text="VIN * (17 символов)" Foreground="White" Opacity="0.8"/>
                <TextBox Text="{Binding Vin}" MaxLength="17" Watermark="JT2BF22K1W0123456"/>

                <TextBlock Text="Госномер *" Foreground="White" Opacity="0.8"/>
                <TextBox Text="{Binding PlateNumber}" Watermark="А123ВС77"/>

                <TextBlock Text="Пробег, км" Foreground="White" Opacity="0.8"/>
                <NumericUpDown Value="{Binding Mileage}"
                               Minimum="0" Maximum="9999999"
                               Increment="1000"
                               FormatString="0"
                               HorizontalAlignment="Stretch"/>

                <TextBlock Text="Цвет" Foreground="White" Opacity="0.8"/>
                <TextBox Text="{Binding Color}" Watermark="Белый"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FFEF5350"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    Padding="20,8"/>
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Background="#FF7C4DFF"
                    Foreground="White"
                    Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>