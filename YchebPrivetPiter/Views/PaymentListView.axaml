<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YchebPrivetPiter.ViewModels"
             xmlns:d="using:YchebPrivetPiter.Data"
             xmlns:controls="using:YchebPrivetPiter.Controls"
             x:Class="YchebPrivetPiter.Views.PaymentListView"
             x:DataType="vm:PaymentListViewModel">
    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="Платежи" FontSize="22" FontWeight="Bold" Foreground="White"/>
            <Button Grid.Column="1" Content="+ Зарегистрировать платёж"
                    Background="#FF7C4DFF" Foreground="White" Padding="14,6"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Способ:" VerticalAlignment="Center" Foreground="White" Opacity="0.8"/>
            <ComboBox SelectedItem="{Binding MethodFilter}"
                      ItemsSource="{Binding AllMethods}"
                      Width="160"/>
            <TextBlock Text="Статус:" VerticalAlignment="Center" Foreground="White" Opacity="0.8"/>
            <ComboBox SelectedItem="{Binding StatusFilter}"
                      ItemsSource="{Binding AllStatuses}"
                      Width="160"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  Background="Transparent"
                  RowBackground="Transparent">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Дата" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Payment" x:DataType="d:Payment">
                            <TextBlock Text="{Binding PaidAt}" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Счёт" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Payment" x:DataType="d:Payment">
                            <TextBlock Text="{Binding Invoice.Number}" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Сумма" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Payment" x:DataType="d:Payment">
                            <TextBlock Text="{Binding Amount}" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Способ" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Payment" x:DataType="d:Payment">
                            <TextBlock Text="{Binding Method}" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Статус" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Payment" x:DataType="d:Payment">
                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Транзакция" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Payment" x:DataType="d:Payment">
                            <TextBlock Text="{Binding TransactionNumber}" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <controls:Paginator DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    </DockPanel>
</UserControl>