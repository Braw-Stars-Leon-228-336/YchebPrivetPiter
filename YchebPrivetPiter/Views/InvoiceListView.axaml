<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YchebPrivetPiter.ViewModels"
             xmlns:d="using:YchebPrivetPiter.Data"
             xmlns:controls="using:YchebPrivetPiter.Controls"
             x:Class="YchebPrivetPiter.Views.InvoiceListView"
             x:DataType="vm:InvoiceListViewModel">
    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBlock Text="Счета" FontSize="22" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="💳 Оплатить"
                    Click="OnPayClick"
                    Background="#FF4CD964" Foreground="White"
                    Padding="14,6" Margin="0,0,8,0"/>

            <Button Grid.Column="2"
                    Content="+ Сформировать счёт"
                    Click="OnCreateClick"
                    Background="#FF7C4DFF" Foreground="White" Padding="14,6"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <TextBlock Text="Статус:" VerticalAlignment="Center" Foreground="White" Opacity="0.8"/>
            <ComboBox SelectedItem="{Binding StatusFilter}"
                      ItemsSource="{Binding AllStatuses}"
                      Width="200"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedInvoice}"
                  DoubleTapped="OnRowDoubleTapped"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  Background="Transparent"
                  RowBackground="Transparent">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Номер" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Invoice" x:DataType="d:Invoice">
                            <TextBlock Text="{Binding Number}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Дата" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Invoice" x:DataType="d:Invoice">
                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Клиент" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Invoice" x:DataType="d:Invoice">
                            <TextBlock Text="{Binding Client.FullName}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Сумма" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Invoice" x:DataType="d:Invoice">
                            <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ₽'}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Статус" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:Invoice" x:DataType="d:Invoice">
                            <TextBlock Text="{Binding Status}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <controls:Paginator DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    </DockPanel>
</UserControl>