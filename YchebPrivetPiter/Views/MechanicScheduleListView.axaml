<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YchebPrivetPiter.ViewModels"
             xmlns:d="using:YchebPrivetPiter.Data"
             xmlns:controls="using:YchebPrivetPiter.Controls"
             x:Class="YchebPrivetPiter.Views.MechanicScheduleListView"
             x:DataType="vm:MechanicScheduleListViewModel">
    <DockPanel LastChildFill="True">

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
            <TextBlock Text="Расписание механиков" FontSize="22" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="✎ Редактировать"
                    Click="OnEditClick"
                    Background="Transparent" Foreground="White"
                    BorderBrush="#55FFFFFF" BorderThickness="1"
                    Padding="14,6" Margin="0,0,8,0"/>

            <Button Grid.Column="2" Content="🗑 Удалить"
                    Click="OnDeleteClick"
                    Background="Transparent" Foreground="#FFEF5350"
                    BorderBrush="#FFEF5350" BorderThickness="1"
                    Padding="14,6" Margin="0,0,8,0"/>

            <Button Grid.Column="3" Content="+ Новый слот"
                    Click="OnAddClick"
                    Background="#FF7C4DFF" Foreground="White" Padding="14,6"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="Механик:" VerticalAlignment="Center" Foreground="White" Opacity="0.8"/>
            <ComboBox SelectedItem="{Binding MechanicFilter}"
                      ItemsSource="{Binding Mechanics}"
                      Width="200">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="d:Mechanic" x:DataType="d:Mechanic">
                        <TextBlock Text="{Binding User.FullName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Статус:" VerticalAlignment="Center" Foreground="White" Opacity="0.8"
                       Margin="12,0,0,0"/>
            <ComboBox SelectedItem="{Binding StatusFilter}"
                      ItemsSource="{Binding AllStatuses}"
                      Width="160"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedSchedule}"
                  DoubleTapped="OnRowDoubleTapped"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  Background="Transparent"
                  RowBackground="Transparent">
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Дата" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:MechanicSchedule" x:DataType="d:MechanicSchedule">
                            <TextBlock Text="{Binding WorkDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Начало" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:MechanicSchedule" x:DataType="d:MechanicSchedule">
                            <TextBlock Text="{Binding StartTime}" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Конец" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:MechanicSchedule" x:DataType="d:MechanicSchedule">
                            <TextBlock Text="{Binding EndTime}" VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Механик" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:MechanicSchedule" x:DataType="d:MechanicSchedule">
                            <TextBlock Text="{Binding Mechanic.User.FullName}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Место" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:MechanicSchedule" x:DataType="d:MechanicSchedule">
                            <TextBlock Text="{Binding RepairPlace.Name}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Статус" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="d:MechanicSchedule" x:DataType="d:MechanicSchedule">
                            <TextBlock Text="{Binding Status}"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <controls:Paginator DockPanel.Dock="Bottom" Margin="0,12,0,0"/>
    </DockPanel>
</UserControl>