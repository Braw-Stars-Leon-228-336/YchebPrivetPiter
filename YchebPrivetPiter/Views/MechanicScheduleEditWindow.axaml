<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YchebPrivetPiter.ViewModels"
        xmlns:d="using:YchebPrivetPiter.Data"
        x:Class="YchebPrivetPiter.Views.MechanicScheduleEditWindow"
        x:DataType="vm:MechanicScheduleEditViewModel"
        Title="{Binding Title}"
        Width="500" Height="520"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#FF1E1E2E">
    <Grid RowDefinitions="*,Auto" Margin="20">

        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="12">

                <TextBlock Text="Механик *" Foreground="White" Opacity="0.8"/>
                <ComboBox ItemsSource="{Binding Mechanics}"
                          SelectedItem="{Binding SelectedMechanic}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="d:Mechanic" x:DataType="d:Mechanic">
                            <TextBlock Text="{Binding User.FullName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Ремонтное место" Foreground="White" Opacity="0.8"/>
                <ComboBox ItemsSource="{Binding RepairPlaces}"
                          SelectedItem="{Binding SelectedPlace}"
                          HorizontalAlignment="Stretch"
                          DisplayMemberBinding="{Binding Name}"/>

                <TextBlock Text="Дата *" Foreground="White" Opacity="0.8"/>
                <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch"/>

                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="Начало *" Foreground="White" Opacity="0.8"/>
                        <TimePicker SelectedTime="{Binding StartTime}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="Конец *" Foreground="White" Opacity="0.8"/>
                        <TimePicker SelectedTime="{Binding EndTime}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Статус" Foreground="White" Opacity="0.8"/>
                <ComboBox ItemsSource="{Binding AllStatuses}"
                          SelectedItem="{Binding Status}"
                          HorizontalAlignment="Stretch"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FFEF5350"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,16,0,0">
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    Padding="20,8"/>
            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Background="#FF7C4DFF"
                    Foreground="White"
                    Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>