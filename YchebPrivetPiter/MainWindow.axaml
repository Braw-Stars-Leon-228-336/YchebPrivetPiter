<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YchebPrivetPiter.ViewModels"
        xmlns:views="using:YchebPrivetPiter.Views"
        x:Class="YchebPrivetPiter.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Автосервис"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Panel Background="#FF1E1E2E">
        <ContentControl Content="{Binding CurrentView}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:LoginViewModel">
                    <views:LoginView/>
                </DataTemplate>
                <DataTemplate DataType="vm:ShellViewModel">
                    <views:ShellView/>
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </Panel>
</Window>