<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YchebPrivetPiter.Controls.Paginator"
             x:CompileBindings="False">
    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
        <Button Content="⏮" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoFirst}" ToolTip.Tip="Первая"/>
        <Button Content="‹" Command="{Binding PrevPageCommand}"  IsEnabled="{Binding CanGoPrev}"  ToolTip.Tip="Назад"/>
        <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center"
                   Foreground="White" Opacity="0.8" Margin="8,0"/>
        <Button Content="›" Command="{Binding NextPageCommand}"  IsEnabled="{Binding CanGoNext}"  ToolTip.Tip="Вперёд"/>
        <Button Content="⏭" Command="{Binding LastPageCommand}"  IsEnabled="{Binding CanGoLast}"  ToolTip.Tip="Последняя"/>

        <ComboBox ItemsSource="{Binding PageSizes}"
                  SelectedItem="{Binding PageSize}"
                  Width="80" Margin="12,0,0,0"/>
        <TextBlock Text="на стр." VerticalAlignment="Center" Foreground="White" Opacity="0.6"/>
    </StackPanel>
</UserControl>