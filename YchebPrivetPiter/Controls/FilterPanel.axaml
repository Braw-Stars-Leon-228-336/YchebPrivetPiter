<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YchebPrivetPiter.Controls.FilterPanel"
             x:Name="Root"
             x:CompileBindings="False">
    <Border Background="#FF2A2A3C" CornerRadius="10" Padding="14" Margin="0,0,0,12">
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding #Root.Header}"
                       FontWeight="SemiBold" Foreground="White" Opacity="0.9"/>
            <ContentPresenter Content="{Binding #Root.FilterContent}"/>
        </StackPanel>
    </Border>
</UserControl>